<Window x:Class="PrototipadoEscritorio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrototipadoEscritorio"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ====================== FONDO CON COLINAS ====================== -->
        <Grid>
            <Image Source="/Assets/Fondo.png" Stretch="Fill" Panel.ZIndex="0" />
        

        <!-- ====================== LAYOUT PRINCIPAL ====================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ====================== SIDEBAR IZQUIERDO ====================== -->
            <Border Grid.Column="0" Background="#1E3A2E">
                <StackPanel VerticalAlignment="Stretch" Margin="0,30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- LOGO -->
                        <StackPanel HorizontalAlignment="Center" Grid.Row="0" Margin="20">
                            <Border Width="200" Height="200" CornerRadius="20" BorderThickness="2">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Captura de pantalla 2025-12-04 132052.png" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <!-- Icon + Texto -->
                        <StackPanel Margin="10" Grid.Row="1">

                            <Button Style="{StaticResource SidebarButton}" Margin="0 50 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Usuarios" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                                <Button Style="{StaticResource SidebarButton}" Background="#2B5E45" Margin="0 0 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Eventos" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}"  Margin="0 0 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comunidades" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tienda" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= BOTÓN HAMBURGUESA SIEMPRE VISIBLE ================= -->
            <Grid Grid.Column="1" Margin="20,20,0,0" VerticalAlignment="Top">
                <Button x:Name="BtnOpciones"
                        Content="☰"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="{StaticResource FontSans}"
                        FontWeight="SemiBold"
                        FontSize="20"
                        Foreground="Black"
                        HorizontalAlignment="Left"
                        Click="BtnOpciones_Click"
                        Margin="0,0,0,10"/>
            </Grid>

            <!-- ================= PANEL DESPLEGABLE COMPLETO ================= -->
            <!-- ============= CONTENIDO PRINCIPAL (TÍTULO) ============= -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical">
            
                <TextBlock Text="Lista eventos"
                           FontSize="60"
                           FontWeight="Bold"
                           Foreground="#1F2A24"
                            HorizontalAlignment="Center"/>
                    <Border CornerRadius="10"
                        Background="White"
                            BorderBrush="Black"
                            BorderThickness="1"
                        Width="700"
                            Height="50"
                            VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        >
                        <TextBox Text="Buscar..."
                             FontSize="18"
                             Foreground="#1F2A24"
                             VerticalAlignment="Center"
                             Background="Transparent"
