<UserControl
    x:Class="PrototipadoEscritorio.Views.AñadirUsuarioUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrototipadoEscritorio.ViewModels.Usuarios"
    d:DesignHeight="650"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:AñadirUsuarioUserControlVM />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TextBlock
                Margin="0,40,0,28"
                HorizontalAlignment="Center"
                FontSize="38"
                FontWeight="SemiBold"
                Foreground="#1F2A24"
                Text="Añadir Usuario" />

            <Border
                Padding="24,20"
                Background="White"
                BorderBrush="#E4E9E6"
                BorderThickness="1"
                CornerRadius="14">

                <Grid Width="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 0: Nombre de usuario  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Nombre de usuario" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="36"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <!--  Row 1: Nombre + Apellido  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Nombre" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="36"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Apellido" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="36"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <!--  Row 2: Email + Edad (3:1)  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#1F2A24"
                                    Text="Email" />
                                <Border
                                    Background="#F6FAF8"
                                    BorderBrush="#E4E9E6"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBox
                                        Height="36"
                                        Padding="12,0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Foreground="#1F2A24"
                                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#1F2A24"
                                    Text="Edad" />
                                <Border
                                    Background="#F6FAF8"
                                    BorderBrush="#E4E9E6"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBox
                                        Height="36"
                                        Padding="12,0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Foreground="#1F2A24"
                                        Text="{Binding Edad, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  Row 3: Contraseña  -->
                    <StackPanel
                        Grid.Row="3"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Contraseña" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="36"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Contraseña, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <!--  Row 4: Descripción  -->
                    <StackPanel
                        Grid.Row="4"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Descripción" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="50"
                                Padding="12,6"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>

                    <!--  Row 5: Separator  -->
                    <Border
                        Grid.Row="5"
                        Grid.ColumnSpan="3"
                        Height="1"
                        Margin="0,0,0,14"
                        Background="#E4E9E6" />

                    <!--  Row 6: Imagen de perfil  -->
                    <StackPanel
                        Grid.Row="6"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,16">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#1F2A24"
                                Text="Imagen de perfil" />
                            <Button
                                Width="130"
                                Height="30"
                                HorizontalAlignment="Right"
                                Background="#3BB273"
                                BorderThickness="0"
                                Command="{Binding SeleccionarImagenCommand}"
                                Content="Seleccionar"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="#999"
                            Text="{Binding RutaImagenLocal, FallbackValue='Ninguna imagen seleccionada', TargetNullValue='Ninguna imagen seleccionada'}" />

                        <Border
                            Width="100"
                            Height="100"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Background="#EDF3EF"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="10">
                            <Image Source="{Binding Previsualizacion}" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <!--  Row 7: Guardar  -->
                    <Button
                        Grid.Row="7"
                        Grid.ColumnSpan="3"
                        Width="120"
                        Height="38"
                        HorizontalAlignment="Right"
                        Background="#3BB273"
                        BorderThickness="0"
                        Command="{Binding GuardarCommand}"
                        Content="Guardar"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
