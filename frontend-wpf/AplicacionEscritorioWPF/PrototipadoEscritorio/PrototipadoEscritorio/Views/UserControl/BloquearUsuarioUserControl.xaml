<UserControl x:Class="PrototipadoEscritorio.Views.BloquearUsuarioUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             Background="white">

    <Border CornerRadius="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <TextBlock Text="{Binding Usuario.NombreUsuario, StringFormat='Bloquear: {0}'}"
                       FontSize="18" FontWeight="Bold" Foreground="White"
                       Background="Orange" Padding="10"
                       HorizontalAlignment="Stretch" TextAlignment="Center"/>

            <!-- Confirmación -->
            <!--<TextBlock Grid.Row="1"
                       Text="{Binding Usuario.NombreUsuario, StringFormat=¿Estás seguro de que quieres bloquear '{0}'?}"
                       Margin="10,10,0,5" TextWrapping="Wrap" FontSize="18" />-->

            <!-- Causa y duración -->
            <StackPanel Grid.Row="2" Margin="10">
                <TextBlock Text="Introduzca la causa y su duración:" Margin="0,5,0,5" FontSize="18"/>

                <TextBox Margin="0,5,0,10" Height="100"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Causa, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Margin="0,5,0,10"
                         Text="{Binding Duracion, UpdateSourceTrigger=PropertyChanged}"
                          />
            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,10,10">
                <Button Content="Cancelar" Width="80" Margin="0,0,10,0"
                        Background="Black" Foreground="White"
                        Command="{Binding CancelarCommand}"/>

                <Button Content="Confirmar" Width="80"
                        Background="Orange" Foreground="White"
                        Command="{Binding ConfirmarCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
