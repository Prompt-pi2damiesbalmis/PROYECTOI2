<UserControl
    x:Class="PrototipadoEscritorio.Views.AñadirEventoUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrototipadoEscritorio.ViewModels.Eventos"
    d:DesignHeight="520"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:AñadirEventoUserControlVM />
    </UserControl.DataContext>

    <Grid>
        <StackPanel
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TextBlock
                Margin="0,40,0,28"
                HorizontalAlignment="Center"
                FontSize="38"
                FontWeight="SemiBold"
                Foreground="#1F2A24"
                Text="Añadir Evento" />

            <Border
                Padding="28,24"
                Background="White"
                BorderBrush="#E4E9E6"
                BorderThickness="1"
                CornerRadius="14">

                <StackPanel Width="300">
                    <!--  Nombre  -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Nombre" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="38"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <!--  Ubicación  -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Ubicación" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="38"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <!--  Descripción  -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Descripción" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBox
                                Height="90"
                                Padding="12,8"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>

                    <!--  Fecha  -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#1F2A24"
                            Text="Fecha" />
                        <Border
                            Background="#F6FAF8"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DatePickerTextBox">
                                                <Grid>
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                                    <ScrollViewer
                                                        x:Name="PART_ContentHost"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Resources>
                            <DatePicker
                                Height="38"
                                Padding="8,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1F2A24"
                                SelectedDate="{Binding Fecha}" />
                        </Border>
                    </StackPanel>

                    <!--  Separator  -->
                    <Border
                        Height="1"
                        Margin="0,0,0,16"
                        Background="#E4E9E6" />

                    <!--  Imagen  -->
                    <StackPanel Margin="0,0,0,20">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#1F2A24"
                                Text="Imagen" />
                            <Button
                                Width="130"
                                Height="30"
                                HorizontalAlignment="Right"
                                Background="#3BB273"
                                BorderThickness="0"
                                Command="{Binding SeleccionarImagenCommand}"
                                Content="Seleccionar"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="#999"
                            Text="{Binding RutaImagenLocal, FallbackValue='Ninguna imagen seleccionada', TargetNullValue='Ninguna imagen seleccionada'}" />

                        <Border
                            Width="120"
                            Height="120"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Background="#EDF3EF"
                            BorderBrush="#E4E9E6"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="10">
                            <Image Source="{Binding Previsualizacion}" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <!--  Guardar  -->
                    <Button
                        Width="120"
                        Height="38"
                        HorizontalAlignment="Right"
                        Background="#3BB273"
                        BorderThickness="0"
                        Command="{Binding GuardarCommand}"
                        Content="Guardar"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
