<UserControl
    x:Class="PrototipadoEscritorio.Views.AñadirEventoUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrototipadoEscritorio.ViewModels.Eventos"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:AñadirEventoUserControlVM />
    </UserControl.DataContext>

    <StackPanel>
        <Label
            Margin="0,0,0,40"
            HorizontalAlignment="Center"
            Content="Añadir Evento"
            FontSize="52" />

        <Border
            Width="420"
            Padding="20"
            Background="White"
            CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Nombre:" />
                    <TextBox
                        Height="32"
                        VerticalAlignment="Center"
                        Style="{StaticResource TextBoxPlaceholderStyle}"
                        Tag="Introduzca el nombre..."
                        Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Ubicación:" />
                    <TextBox
                        Height="32"
                        Style="{StaticResource TextBoxPlaceholderStyle}"
                        Tag="Ubicación..."
                        Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Descripción:" />
                    <TextBox
                        Height="80"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        Style="{StaticResource TextBoxPlaceholderStyle}"
                        Tag="Descripción del evento..."
                        Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Fecha:" />
                    <DatePicker
                        Height="32"
                        SelectedDate="{Binding Fecha}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Imagen:" />
                        <Button
                            Width="150"
                            Height="28"
                            Padding="10,0"
                            HorizontalAlignment="Right"
                            Command="{Binding SeleccionarImagenCommand}"
                            Content="Seleccionar img"
                            DockPanel.Dock="Right" />
                    </DockPanel>

                    <TextBlock
                        Margin="0,4,0,8"
                        FontSize="12"
                        Foreground="Gray"
                        Text="{Binding RutaImagenLocal, FallbackValue='Ninguna imagen seleccionada'}" />

                    <Border
                        Padding="10"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Image
                            Width="120"
                            Height="120"
                            Source="{Binding Previsualizacion}"
                            Stretch="Uniform" />
                    </Border>
                </StackPanel>

                <Button
                    Grid.Row="6"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Right"
                    Background="#4CAF50"
                    BorderThickness="0"
                    Command="{Binding GuardarCommand}"
                    Content="Guardar"
                    Foreground="White" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>