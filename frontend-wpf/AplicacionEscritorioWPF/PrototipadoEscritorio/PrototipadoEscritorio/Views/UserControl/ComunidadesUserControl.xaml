<UserControl
    x:Class="PrototipadoEscritorio.Views.ComunidadesUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  ================= BOTÓN HAMBURGUESA =================  -->
        <Grid
            Grid.Column="1"
            Margin="10"
            VerticalAlignment="Top">
            <Button
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Content="☰"
                FontSize="20" />
            <!--<Button x:Name="BtnOpciones"
        Content="☰"
        Background="Transparent"
        BorderThickness="0"
        FontSize="20"
        HorizontalAlignment="Left"
        />-->
        </Grid>

        <!--  ====================== CONTENIDO PRINCIPAL ======================  -->
        <StackPanel Grid.Column="1" Margin="60,120,60,60">

            <Label
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Content="Lista de Comunidades"
                FontSize="52" />
            <Grid
                Width="600"
                Height="40"
                Margin="0,0,0,40">
                <Border
                    Padding="12,0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="#888"
                            Text="🔍" />

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14" />
                    </Grid>
                </Border>

                <TextBlock
                    Margin="48,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#999"
                    IsHitTestVisible="False"
                    Text="Buscar comunidad"
                    Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <UniformGrid
                Grid.Row="3"
                Grid.RowSpan="2"
                Height="416"
                Margin="0,49,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Columns="3">

                <!--  Primera fila  -->
                <Button Margin="4" Style="{StaticResource CommunityCardButton}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Título de la comunidad  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,10,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Eco Acción" />

                        <!--  Imagen con esquinas inferiores redondeadas  -->
                        <Border
                            Grid.Row="1"
                            ClipToBounds="True"
                            CornerRadius="0,0,8,8">
                            <Image Source="/Assets/comunidad2.jpg" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Button>

                <Button Margin="4" Style="{StaticResource CommunityCardButton}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Título de la comunidad  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,10,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Tribu Verde" />

                        <!--  Imagen con esquinas inferiores redondeadas  -->
                        <Border
                            Grid.Row="1"
                            ClipToBounds="True"
                            CornerRadius="0,0,8,8">
                            <Image Source="/Assets/comunidad3.jpg" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Button>

                <Button Margin="4" Style="{StaticResource CommunityCardButton}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Título de la comunidad  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,10,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Playas limpias" />

                        <!--  Imagen con esquinas inferiores redondeadas  -->
                        <Border
                            Grid.Row="1"
                            ClipToBounds="True"
                            CornerRadius="0,0,8,8">
                            <Image Source="/Assets/comunidad6.jpg" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Button>

                <Button Margin="4" Style="{StaticResource CommunityCardButton}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Título de la comunidad  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,10,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Todos Unidos" />

                        <!--  Imagen con esquinas inferiores redondeadas  -->
                        <Border
                            Grid.Row="1"
                            ClipToBounds="True"
                            CornerRadius="0,0,8,8">
                            <Image Source="/Assets/todosunidos.png" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Button>

                <Button Margin="4" Style="{StaticResource CommunityCardButton}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Título de la comunidad  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,10,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Eco Connection" />

                        <!--  Imagen con esquinas inferiores redondeadas  -->
                        <Border
                            Grid.Row="1"
                            ClipToBounds="True"
                            CornerRadius="0,0,8,8">
                            <Image Source="/Assets/comunidad4.jpg" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Button>

                <Button Margin="4" Style="{StaticResource CommunityCardButton}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Título de la comunidad  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,10,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Eco Tech" />

                        <!--  Imagen con esquinas inferiores redondeadas  -->
                        <Border
                            Grid.Row="1"
                            ClipToBounds="True"
                            CornerRadius="0,0,8,8">
                            <Image Source="/Assets/EcoTech.jpg" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Button>

            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
