                HorizontalAlignment="Center"
                Content="Accesorios"
                FontSize="52" />

            <Grid
                Width="600"
                Height="40"
                Margin="0,0,0,40">
                <Border
                    Padding="12,0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="20">

