                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CardSubTextStyle}"
                            Text="500 pts" />

                        <Border Grid.Row="2" Style="{StaticResource CardImageContainerStyle}">
                            <Image
                                Width="120"
                                Height="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Marco-Personalizado.jpg"
                                Stretch="Uniform" />
                        </Border>

                        <Button
                            Grid.Row="3"
                            Content="Editar"
                            Style="{StaticResource CardButtonStyle}" />
                    </Grid>
                </Border>

