                            Grid.Row="2"
                            Margin="0,0,0,0"
                            Background="#EFEAF4">

                            <Image
                                Width="120"
                                Height="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Marco-Personalizado.jpg"
                                Stretch="Uniform" />
                        </Border>

                        <!--  BOTÓN  -->
                        <Button
                            Grid.Row="3"
                            Height="44"
                            Margin="0"
                            Background="#4CAF50"
                            BorderThickness="0"
                            Content="Editar"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="0,0,14,14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
