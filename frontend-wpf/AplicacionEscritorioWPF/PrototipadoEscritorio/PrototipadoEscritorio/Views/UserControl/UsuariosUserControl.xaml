                    Margin="6"
                    Background="#FFF5F5F5"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="75" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="50"
                            Height="50"
                            BorderThickness="1">
                            <Border.Background>
                                <ImageBrush
                                    ImageSource="/Assets/avatares.png"
                                    Stretch="UniformToFill"
                                    Viewbox="0.33,0.0,0.33,0.33"
                                    ViewboxUnits="RelativeToBoundingBox" />
                            </Border.Background>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#333"
                                Text="Apellido, Nombre" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#007ACC"
                                Text="Nombre Usuario" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#666"
                                Text="Comunidades..." />

                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="2"
                            VerticalAlignment="Bottom">
                            <Button
                                Width="63"
                                Height="15"
                                Margin="2"
                                Background="Orange"
                                BorderThickness="0"
                                Content="Bloquear"
                                FontSize="9"
                                Foreground="White"
                                Style="{StaticResource RoundedButton}" />
                            <Button
                                Width="63"
                                Height="15"
                                Margin="2"
                                Background="IndianRed"
                                BorderThickness="0"
                                Content="Eliminar"
                                FontSize="9"
                                Foreground="White"
                                Style="{StaticResource RoundedButton}" />
                        </StackPanel>
                    </Grid>
                </Border>



            </UniformGrid>

        </StackPanel>
    </Grid>
</UserControl>
