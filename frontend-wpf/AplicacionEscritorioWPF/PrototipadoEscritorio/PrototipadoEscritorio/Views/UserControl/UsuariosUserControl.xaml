                        <TextBlock Text="Nombre Usuario" FontSize="16" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock Text="Comunidades..." FontSize="12" Foreground="#666"/>

                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="2" VerticalAlignment="Bottom">
