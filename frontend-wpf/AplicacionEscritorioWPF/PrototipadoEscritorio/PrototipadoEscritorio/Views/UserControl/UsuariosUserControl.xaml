                            <ImageBrush ImageSource="/Assets/avatares.png"
                                Viewbox="0.33,0.0,0.33,0.33"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="UniformToFill"
                            />
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" >
