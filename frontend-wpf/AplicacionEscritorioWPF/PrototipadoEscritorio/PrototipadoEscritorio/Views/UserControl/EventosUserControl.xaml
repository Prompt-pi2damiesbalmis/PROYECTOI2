                Width="600"
                Height="40"
                Margin="0,0,0,40">
                <Border
                    Padding="12,0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="#888"
                            Text="🔍" />

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14" />
                    </Grid>
                </Border>

                <TextBlock
                    Margin="48,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#999"
                    IsHitTestVisible="False"
                    Text="Buscar evento"
                    Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

