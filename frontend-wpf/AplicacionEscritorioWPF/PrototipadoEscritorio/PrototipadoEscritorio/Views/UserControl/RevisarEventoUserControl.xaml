<UserControl x:Class="PrototipadoEscritorio.Views.RevisarEventoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="250"
             d:DesignWidth="600"
             Background="White">

    <Border CornerRadius="10" Background="White">
        <Grid>

            <!-- Filas -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Encabezado -->
                <RowDefinition Height="*"/>
                <!-- Causa -->
                <RowDefinition Height="Auto"/>
                <!-- Botones -->
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Evento.Nombre, StringFormat='Mandar a revisar: {0}'}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Background="Orange"
                       Padding="10"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Center"/>

            <!-- Causa -->
            <StackPanel Grid.Row="1" Margin="10">
                <TextBlock Text="Razón por la cual tiene que revisarse:"
                           Margin="0,5,0,5"
                           FontSize="18"/>

                <TextBox Height="100"
                         Margin="0,5,0,10"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Razon, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,10,10">

                <Button Content="Cancelar"
                        Width="80"
                        Margin="0,0,10,0"
                        Background="Black"
                        Foreground="White"
                        Command="{Binding CancelarCommand}"/>

                <Button Content="Confirmar"
                        Width="80"
                        Background="Orange"
                        Foreground="White"
                        Command="{Binding ConfirmarCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
