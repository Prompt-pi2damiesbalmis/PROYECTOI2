<Page x:Class="PrototipadoEscritorio.Views.ListaComunidades"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="ListaComunidades">

    <Grid>

        <!-- ====================== FONDO CON COLINAS ====================== -->
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Fondo.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
            </Grid.Background>
        </Grid>

        <!-- ====================== LAYOUT PRINCIPAL ====================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ====================== SIDEBAR IZQUIERDO ====================== -->
            <Border Grid.Column="0" Background="#1E3A2E">
                <StackPanel VerticalAlignment="Stretch" Margin="0,30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- LOGO -->
                        <StackPanel HorizontalAlignment="Center" Grid.Row="0" Margin="20">
                            <Border Width="200" Height="200" CornerRadius="20" BorderThickness="2">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Captura de pantalla 2025-12-04 132052.png" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <!-- Icon + Texto -->
                        <StackPanel Margin="10" Grid.Row="1">

                            <Button Style="{StaticResource SidebarButton}" Margin="0 50 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Usuarios" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}" Margin="0 0 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Eventos" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}" Margin="0 0 0 50" Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comunidades" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tienda" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= BOTÓN HAMBURGUESA SIEMPRE VISIBLE ================= -->
            <Grid Grid.Column="1" Margin="20,20,0,0" VerticalAlignment="Top">
                <Button x:Name="BtnOpciones"
                    Content="☰"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{StaticResource FontSans}"
                    FontWeight="SemiBold"
                    FontSize="20"
                    Foreground="Black"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>
            </Grid>

            <!-- ================= PANEL DESPLEGABLE COMPLETO ================= -->
            <Grid Grid.Column="1" x:Name="PanelOpcionesContainer" Height="0" ClipToBounds="True" VerticalAlignment="Top" Margin="0,60,0,0">
                <Border Background="White">
                    <StackPanel Margin="20">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Lista de Eventos" Margin="0,8" FontSize="14" Foreground="Black"/>
                            <TextBlock Text="Eventos en revisión" Margin="0,8" FontSize="14" Foreground="Black"/>
                            <TextBlock Text="Eliminar evento" Margin="0,8" FontSize="14" Foreground="Black"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============= CONTENIDO PRINCIPAL ================= -->
            <Grid Grid.Column="1" Margin="68,40,80,40" Grid.ColumnSpan="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="1"
                           Text="Lista de Comunidades"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="#1F2A24"
                           HorizontalAlignment="Center"
                           Margin="0 10 0 0"/>

                <!-- Buscador -->
                <Border Grid.Row="2"
                        Margin="0 20 0 30"
                        Height="40"
                        Width="520"
                        Background="White"
                        CornerRadius="20"
                        HorizontalAlignment="Center">

                    <DockPanel Margin="15 0">
                        <TextBlock Text="🔍"
                                   VerticalAlignment="Center"
                                   Margin="0 0 10 0"/>
                        <TextBox Text="Buscar usuario"
                                 BorderThickness="0"
                                 Foreground="#8A9A91"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Border>

                <UniformGrid Grid.Row="3"
             Columns="3"
             Rows="2"
             HorizontalAlignment="Center">

                    <Button Style="{StaticResource CommunityCardButton}" Margin="15">
                        <StackPanel>
                            <Border Height="120" CornerRadius="12" ClipToBounds="True">
                                <Image Source="/Assets/comunidad2.jpg" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Eco Acción"
                       Margin="0 12 0 0"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CommunityCardButton}" Margin="15">
                        <StackPanel>
                            <Border Height="120" CornerRadius="12" ClipToBounds="True">
                                <Image Source="/Assets/comunidad3.jpg" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Tribu Verde"
                       Margin="0 12 0 0"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CommunityCardButton}" Margin="15">
                        <StackPanel>
                            <Border Height="120" CornerRadius="12" ClipToBounds="True">
                                <Image Source="/Assets/comunidad5.jpg" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Playas Limpias"
                       Margin="0 12 0 0"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CommunityCardButton}" Margin="15">
                        <StackPanel>
                            <Border Height="120" CornerRadius="12" ClipToBounds="True">
                                <Image Source="/Assets/comunidad6.jpg" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Eco Tech"
                       Margin="0 12 0 0"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CommunityCardButton}" Margin="15">
                        <StackPanel>
                            <Border Height="120" CornerRadius="12" ClipToBounds="True">
                                <Image Source="/Assets/todosunidos.png" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Todos Unidos"
                       Margin="0 12 0 0"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CommunityCardButton}" Margin="15">
                        <StackPanel>
                            <Border Height="120" CornerRadius="12" ClipToBounds="True">
                                <Image Source="/Assets/EcoTech.jpg" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Eco Connection"
                       Margin="0 12 0 0"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>

            </Grid>
        </Grid>
    </Grid>
</Page>
