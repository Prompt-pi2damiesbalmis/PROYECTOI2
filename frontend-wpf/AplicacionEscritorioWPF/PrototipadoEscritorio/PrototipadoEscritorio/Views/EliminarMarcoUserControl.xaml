<UserControl x:Class="PrototipadoEscritorio.Views.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="500"
             Background="white">
    <Border CornerRadius="10" Background="White">
    <Grid >
        <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Confirmación -->
                <RowDefinition Height="*"/>
                <!-- Causa y duración -->
            
            <!-- Input -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
        </Grid.RowDefinitions>
        <!-- Encabezado -->
            <TextBlock Text="Eliminar: MARCO" FontSize="18" FontWeight="Bold" Foreground="White" Background="#AF4C4E" Padding="10" HorizontalAlignment="Stretch" TextAlignment="Center"/>
        <!-- Confirmación -->
            <TextBlock Grid.Row="1" Text="¿Estás seguro de que quieres eliminar 'MARCO'?" Margin="10,20,0,5" TextWrapping="Wrap" FontSize="18" />

       
        
        
        <!-- Botones -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
                <Button Content="Cancelar" Width="80" Margin="0,0,10,0" Background="Black" Foreground="White"/>
                <Button Content="Confirmar" Width="80" Background="#AF4C4E" Foreground="White"/>
            </StackPanel>
    </Grid>
    </Border>
</UserControl>
