<UserControl x:Class="PrototipadoEscritorio.Views.ComunidadesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- ================= BOTÓN HAMBURGUESA ================= -->
        <Grid Grid.Column="1"
                      Margin="10"
                      VerticalAlignment="Top">
            <Button Content="☰"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            HorizontalAlignment="Left"
                            />
            <!--<Button x:Name="BtnOpciones"
        Content="☰"
        Background="Transparent"
        BorderThickness="0"
        FontSize="20"
        HorizontalAlignment="Left"
        />-->
        </Grid>

        <!-- ====================== CONTENIDO PRINCIPAL ====================== -->
        <StackPanel Grid.Column="1"
                            Margin="60,120,60,60">

            <Label Content="Lista de Comunidades"
                           HorizontalAlignment="Center"
                           FontSize="52"
                           Margin="0,0,0,20"/>
            <Grid Width="600" Height="40"  Margin="0,0,0,0">
                <Border
            CornerRadius="20"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Padding="12,0"
        >

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
Text="🔍"
FontSize="16"
VerticalAlignment="Center"
Foreground="#888"/>

                        <TextBox
Grid.Column="1"
Margin="8,0,0,0"
VerticalAlignment="Center"
BorderThickness="0"
Background="Transparent"
FontSize="14"/>

                        <!--<TextBox
x:Name="SearchBox"
Grid.Column="1"
Margin="8,0,0,0"
VerticalAlignment="Center"
BorderThickness="0"
Background="Transparent"
FontSize="14"/>-->
                    </Grid>
                </Border>

                <TextBlock
            Text="Buscar comunidad"
            Margin="48,0,0,0"
            VerticalAlignment="Center"
            Foreground="#999"
            IsHitTestVisible="False"
            Visibility="{Binding Text.IsEmpty,
                                 ElementName=SearchBox,
                    Converter={StaticResource BooleanToVisibilityConverter}}"
        />
            </Grid>

            <UniformGrid Grid.Row="3"
                         Columns="3"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,49,0,0" Grid.RowSpan="2" Height="416"
                    >

                <!-- Primera fila -->
                <Button Style="{StaticResource CommunityCardButton}" Margin="4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título de la comunidad -->
                        <TextBlock Text="Eco Acción"
                                   Grid.Row="0"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="10,10,10,8"/>

                        <!-- Imagen con esquinas inferiores redondeadas -->
                        <Border Grid.Row="1"
                                    CornerRadius="0,0,8,8" 
                                    ClipToBounds="True">
                            <Image Source="/Assets/comunidad2.jpg" 
                                       Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Style="{StaticResource CommunityCardButton}" Margin="4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título de la comunidad -->
                        <TextBlock Text="Tribu Verde"
                                   Grid.Row="0"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="10,10,10,8"/>

                        <!-- Imagen con esquinas inferiores redondeadas -->
                        <Border Grid.Row="1"
                                    CornerRadius="0,0,8,8" 
                                    ClipToBounds="True">
                            <Image Source="/Assets/comunidad3.jpg" 
                                        Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Style="{StaticResource CommunityCardButton}" Margin="4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título de la comunidad -->
                        <TextBlock Text="Playas limpias"
                                    Grid.Row="0"
                                    FontWeight="SemiBold"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    Margin="10,10,10,8"
                                />

                        <!-- Imagen con esquinas inferiores redondeadas -->
                        <Border Grid.Row="1"
                                    CornerRadius="0,0,8,8" 
                                    ClipToBounds="True">
                            <Image Source="/Assets/comunidad6.jpg" 
                                       Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Style="{StaticResource CommunityCardButton}" Margin="4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título de la comunidad -->
                        <TextBlock Text="Todos Unidos"
                                   Grid.Row="0"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="10,10,10,8"
                                />

                        <!-- Imagen con esquinas inferiores redondeadas -->
                        <Border Grid.Row="1"
                                    CornerRadius="0,0,8,8" 
                                    ClipToBounds="True">
                            <Image Source="/Assets/todosunidos.png" 
                                       Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Style="{StaticResource CommunityCardButton}" Margin="4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título de la comunidad -->
                        <TextBlock Text="Eco Connection"
                                   Grid.Row="0"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="10,10,10,8"
                                />

                        <!-- Imagen con esquinas inferiores redondeadas -->
                        <Border Grid.Row="1"
                                    CornerRadius="0,0,8,8" 
                                    ClipToBounds="True">
                            <Image Source="/Assets/comunidad4.jpg" 
                                       Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Style="{StaticResource CommunityCardButton}" Margin="4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título de la comunidad -->
                        <TextBlock Text="Eco Tech"
                                   Grid.Row="0"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="10,10,10,8"
                                />

                        <!-- Imagen con esquinas inferiores redondeadas -->
                        <Border Grid.Row="1"
                                    CornerRadius="0,0,8,8" 
                                    ClipToBounds="True">
                            <Image Source="/Assets/EcoTech.jpg" 
                                       Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Button>

            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
