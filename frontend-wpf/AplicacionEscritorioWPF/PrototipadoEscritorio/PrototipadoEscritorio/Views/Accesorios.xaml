        <!-- ====================== FONDO ====================== -->
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Fondo.png"
            Stretch="UniformToFill"
            AlignmentX="Center"
            AlignmentY="Center"/>
            </Grid.Background>

