                <StackPanel Grid.Column="1"
                Margin="60,120,60,60">

                    <Label Content="Usuarios"
               HorizontalAlignment="Center"
               FontSize="52"
               Margin="0,0,0,20"/>

                    <Grid Width="600" Height="40"  Margin="0,0,0,40">
