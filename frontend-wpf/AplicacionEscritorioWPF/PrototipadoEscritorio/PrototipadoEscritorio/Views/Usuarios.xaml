        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
        mc:Ignorable="d"
        Title="Usuario" Height="900" Width="1400">
    <Grid>

        <!-- ====================== FONDO ====================== -->
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Fondo.png"
                    Stretch="UniformToFill"
                    AlignmentX="Center"
                    AlignmentY="Center"/>
            </Grid.Background>

            <!-- ====================== LAYOUT PRINCIPAL ====================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ====================== SIDEBAR IZQUIERDO (SIN CAMBIOS) ====================== -->
                <DockPanel Grid.Column="0" Background="#1E3A2E">
                    <StackPanel VerticalAlignment="Stretch">
                        <Grid Height="883">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="179"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- LOGO -->
                            <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Grid.Row="0"
                            Margin="0,20,0,20"
                            Width="122">
                                <Border Width="123"
                            Height="123"
                            CornerRadius="20"
                            BorderThickness="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Assets/Captura de pantalla 2025-12-04 132052.png"
                                        Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </StackPanel>

                            <!-- BOTONES -->
                            <StackPanel Grid.Row="1">

                                <Button Style="{StaticResource SidebarButton}" Height="175" Background="#2B5E45">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Usuarios" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Height="153">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🏠" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Eventos" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Height="176">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Comunidades" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}"
                            
                            Height="175">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tienda" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- ================= BOTÓN HAMBURGUESA ================= -->
                <Grid Grid.Column="1"
                Margin="10"
                VerticalAlignment="Top"
            >
                    <Button Content="☰"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="20"
                    HorizontalAlignment="Left"
                />
                </Grid>

