<UserControl x:Class="PrototipadoEscritorio.Views.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="600"
             Background="white">
    <Border CornerRadius="10" Background="White">
    <Grid >
        <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Confirmación -->
                
                <!-- Causa y duración -->
            <RowDefinition Height="*"/>
            <!-- Input -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
        </Grid.RowDefinitions>
        <!-- Encabezado -->
        <TextBlock Text="Mandar a revisar: Evento" FontSize="18" FontWeight="Bold" Foreground="White" Background="Orange" Padding="10" HorizontalAlignment="Stretch" TextAlignment="Center"/>
        <!-- Confirmación -->
           

        <StackPanel Grid.Row="1" Margin="10">
            <!-- Causa y duración -->
            <TextBlock Text="Razon por la cual tiene que revisarse:" Margin="0,5,0,5" FontSize="18"/>
            <!-- Input de texto -->
            <TextBox Margin="0,5,0,10" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="Razon..." />
        </StackPanel>
        
        
        <!-- Botones -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
                <Button Content="Cancelar" Width="80" Margin="0,0,10,0" Background="Black" Foreground="White"/>
                <Button Content="Confirmar" Width="80" Background="Orange" Foreground="White"/>
            </StackPanel>
    </Grid>
    </Border>
</UserControl>
