                        <TextBlock Grid.Row="0"
                                   Text="Marco Perfil"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="16,14,16,4"
                                />

                        <!-- PUNTOS -->
                        <TextBlock Grid.Row="1"
                                   Text="500 pts"
                                   FontSize="14"
                                   Foreground="Gray"
                                   Margin="16,0,16,8"
                                />

                        <!-- IMAGEN -->
                        <Border Grid.Row="2"
                                    Background="#EFEAF4"
                                    Margin="0,0,0,0"
                                >

                            <Image Source="/Assets/Marco-Personalizado.jpg"
                                       Width="120"
                                       Height="120"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                    />
