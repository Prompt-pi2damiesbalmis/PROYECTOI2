<Window x:Class="PrototipadoEscritorio.Views.AñadirAccesorio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrototipadoEscritorio.Views"
        mc:Ignorable="d"
        Title="Tienda" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ====================== FONDO ====================== -->
        <Grid>
            <Image Source="/Assets/Fondo.png"
                   Stretch="Fill"
                   Panel.ZIndex="0"
                   Margin="10,0,0,0"/>

            <!-- ====================== LAYOUT PRINCIPAL ====================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ====================== SIDEBAR IZQUIERDO (SIN CAMBIOS) ====================== -->
                <DockPanel Grid.Column="0" Background="#1E3A2E">
                    <StackPanel VerticalAlignment="Stretch">
                        <Grid Height="883">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="179"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- LOGO -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Grid.Row="0"
                                        Margin="0,20,0,20"
                                        Width="122">
                                <Border Width="123"
                                        Height="123"
                                        CornerRadius="20"
                                        BorderThickness="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Assets/Captura de pantalla 2025-12-04 132052.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </StackPanel>

                            <!-- BOTONES -->
                            <StackPanel Grid.Row="1">

                                <Button Style="{StaticResource SidebarButton}" Height="175">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Usuarios" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Height="153">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🏠" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Eventos" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Height="176">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Comunidades" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}"
                                        Background="#2B5E45"
                                        Height="175">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tienda" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- ================= BOTÓN HAMBURGUESA ================= -->
                <Grid Grid.Column="1"
                      Margin="10"
                      VerticalAlignment="Top">
                    <Button x:Name="BtnOpciones"
                            Content="☰"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            HorizontalAlignment="Left"
                            Click="BtnOpciones_Click"
                            />
                </Grid>

                <!-- ====================== CONTENIDO PRINCIPAL ====================== -->
                <StackPanel Grid.Column="1"
                            Margin="60,120,60,60">

                    <Label Content="Añadir Accesorio"
                           HorizontalAlignment="Center"
                           FontSize="52"
                           Margin="0,0,0,40"/>

                    <Border CornerRadius="12"
                            Background="#F7F9F5"
                            Padding="20"
                            Width="420">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nombre -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Nombre:" FontWeight="SemiBold"/>
                                <TextBox Height="32"
                                         Style="{StaticResource TextBoxPlaceholderStyle}"
                                         Tag="Introduzca el nombre..."/>
                            </StackPanel>

                            <!-- Puntos -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="Puntos:" FontWeight="SemiBold"/>
                                <TextBox Height="32"
                                         Style="{StaticResource TextBoxPlaceholderStyle}"
                                         Tag="Puntos..."/>
                            </StackPanel>

                            <!-- Imagen -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="Imagen:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="Seleccionar img"
                                            DockPanel.Dock="Right"
                                            Height="28"
                                            Padding="10,0" Width="313"/>
                                </DockPanel>

                                <TextBlock Text="Marco-Personalizado.jpg"
                                           FontSize="12"
                                           Foreground="Gray"
                                           Margin="0,4,0,8"/>

                                <Border BorderBrush="#DDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <Image Width="120"
                                           Height="120"
                                           Stretch="Uniform"/>
                                </Border>
                            </StackPanel>

                            <!-- Guardar -->
                            <Button Grid.Row="4"
                                    Content="Guardar"
                                    Height="36"
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>
