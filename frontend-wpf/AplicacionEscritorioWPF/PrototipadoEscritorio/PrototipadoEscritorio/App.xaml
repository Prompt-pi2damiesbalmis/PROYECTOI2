<Application x:Class="PrototipadoEscritorio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrototipadoEscritorio"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        
        <!-- Paleta de colores -->
        <Color x:Key="ColorBg">#FFF6F9F5</Color>
        <Color x:Key="ColorSidebar">#FF1E3A2E</Color>
        <Color x:Key="ColorSidebarAccent">#FF2B5E45</Color>
        <Color x:Key="ColorPrimaryText">#FF1F2A24</Color>
        <Color x:Key="ColorSecondaryText">#FF5A6B60</Color>
        <Color x:Key="ColorCard">#FFFFFFFF</Color>
        <Color x:Key="ColorBorder">#1A1F2A24</Color>
        <Color x:Key="ColorAccent">#FF3BB273</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
        <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
        <SolidColorBrush x:Key="BrushSidebarAccent" Color="{StaticResource ColorSidebarAccent}" />
        <SolidColorBrush x:Key="BrushPrimaryText" Color="{StaticResource ColorPrimaryText}" />
        <SolidColorBrush x:Key="BrushSecondaryText" Color="{StaticResource ColorSecondaryText}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />

        <!-- Tipografías -->
        <FontFamily x:Key="FontSans">Segoe UI</FontFamily>

        <!-- Estilos de texto -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        </Style>

        <!-- Botón de la barra lateral -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,4,0,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSidebarAccent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSidebarAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tarjeta / panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Item de opciones -->
        <Style x:Key="OptionItem" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- Separador visual sutil -->
        <Style x:Key="SoftSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#14000000" />
            <Setter Property="Margin" Value="0,10,0,10" />
        </Style>

        <Style x:Key="CommunityCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                Width="200"
                Height="230"
                Background="White"
                CornerRadius="16"
                Padding="12">

                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="4"
                                          Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
