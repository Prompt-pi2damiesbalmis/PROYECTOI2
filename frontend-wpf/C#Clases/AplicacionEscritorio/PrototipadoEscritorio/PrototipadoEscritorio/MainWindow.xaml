<Window x:Class="PrototipadoEscritorio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrototipadoEscritorio"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ====================== FONDO CON COLINAS ====================== -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF6F9F5" Offset="0"/>
                    <GradientStop Color="#FFEFF6F0" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Path Fill="#D5EEDC" Opacity="0.7" Stretch="Fill"
                  Data="M0,300 C200,250 300,400 560,340 C800,300 920,420 1120,360 L1120,720 L0,720 Z"/>
            <Path Fill="#BEE6CC" Opacity="0.6" Stretch="Fill"
                  Data="M0,380 C220,330 340,480 600,420 C820,380 940,500 1120,460 L1120,720 L0,720 Z"/>
            <Path Fill="#9FDDB8" Opacity="0.5" Stretch="Fill"
                  Data="M0,440 C240,400 360,520 620,480 C840,450 960,540 1120,520 L1120,720 L0,720 Z"/>
        </Grid>

        <!-- ====================== LAYOUT PRINCIPAL ====================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ====================== SIDEBAR IZQUIERDO ====================== -->
            <Border Grid.Column="0" Background="#1E3A2E">
                <StackPanel VerticalAlignment="Stretch" Margin="0,30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- LOGO -->
                        <StackPanel HorizontalAlignment="Center" Grid.Row="0" Margin="20">
                            <Border Width="200" Height="200" CornerRadius="20" BorderThickness="2">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Captura de pantalla 2025-12-04 132052.png" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <!-- Icon + Texto -->
                        <StackPanel Margin="10" Grid.Row="1">

                            <Button Style="{StaticResource SidebarButton}" Margin="0 50 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Usuarios" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}" Margin="0 0 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Eventos" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}" Background="#2B5E45" Margin="0 0 0 50">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comunidades" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tienda" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= BOTÓN HAMBURGUESA SIEMPRE VISIBLE ================= -->
            <Grid Grid.Column="1" Margin="20,20,0,0" VerticalAlignment="Top">
                <Button x:Name="BtnOpciones"
                        Content="☰"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="{StaticResource FontSans}"
                        FontWeight="SemiBold"
                        FontSize="20"
                        Foreground="Black"
                        HorizontalAlignment="Left"
                        Click="BtnOpciones_Click"
                        Margin="0,0,0,10"/>
            </Grid>

            <!-- ================= PANEL DESPLEGABLE COMPLETO ================= -->
            <Grid Grid.Column="1" x:Name="PanelOpcionesContainer" Height="0" ClipToBounds="True" VerticalAlignment="Top" Margin="0,60,0,0">
                <Border Background="White">
                    <StackPanel Margin="20">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Lista de Eventos" Margin="0,8" FontSize="14" Foreground="Black"/>
                            <TextBlock Text="Eventos en revisión" Margin="0,8" FontSize="14" Foreground="Black"/>
                            <TextBlock Text="Eliminar evento" Margin="0,8" FontSize="14" Foreground="Black"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============= CONTENIDO PRINCIPAL (TÍTULO) ============= -->
            <Grid Grid.Column="2" Margin="150 10 0 0">
                <TextBlock Text="Comunidades"
                           FontSize="60"
                           FontWeight="Bold"
                           Foreground="#1F2A24"
                           VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
