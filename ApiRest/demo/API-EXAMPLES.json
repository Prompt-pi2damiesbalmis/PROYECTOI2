{
  "info": {
    "name": "API REST - Plataforma Gamificación",
    "description": "Colección de ejemplos para todos los endpoints",
    "version": "1.0.0"
  },
  "baseUrl": "http://localhost:8080/api",
  "requests": [
    {
      "name": "Info API",
      "method": "GET",
      "endpoint": "/api",
      "description": "Obtiene información general de la API"
    },
    {
      "name": "Health Check",
      "method": "GET",
      "endpoint": "/api/health",
      "description": "Verifica el estado de la API"
    },
    {
      "section": "USUARIOS",
      "endpoints": [
        {
          "name": "Obtener todos los usuarios",
          "method": "GET",
          "endpoint": "/api/usuarios",
          "description": "Lista todos los usuarios del sistema"
        },
        {
          "name": "Obtener usuario por ID",
          "method": "GET",
          "endpoint": "/api/usuarios/1",
          "description": "Obtiene un usuario específico"
        },
        {
          "name": "Crear usuario",
          "method": "POST",
          "endpoint": "/api/usuarios",
          "description": "Crea un nuevo usuario",
          "body": {
            "usuario": "nuevo_usuario",
            "contraseña": "password123",
            "nombre": "Juan",
            "apellidos": "Pérez González",
            "correo": "juan@example.com",
            "admin": false,
            "puntos": 0,
            "puntosExperiencia": 0
          }
        },
        {
          "name": "Actualizar usuario",
          "method": "PUT",
          "endpoint": "/api/usuarios/1",
          "description": "Actualiza datos de un usuario",
          "body": {
            "nombre": "Juan Roberto",
            "apellidos": "Pérez López",
            "puntos": 150
          }
        },
        {
          "name": "Eliminar usuario",
          "method": "DELETE",
          "endpoint": "/api/usuarios/1",
          "description": "Elimina un usuario"
        }
      ]
    },
    {
